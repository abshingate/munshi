# Copy this file to terraform.tfvars and fill in your values.

# Your public IP with /32 — find it with:  curl -s https://checkip.amazonaws.com
allowed_cidr = "1.2.3.4/32"

# Everything below is optional (sensible defaults shown).
# Tally build: "editlog" = TallyPrime Edit Log (always-on audit trail —
# REQUIRED for Pvt Ltd / Ltd companies under MCA rules; safe default).
# Proprietorships/partnerships may set "standard".
# tally_edition           = "editlog"
#
# Stable address (recommended if you own a domain with DNS on AWS Route 53):
# the VM keeps this A record pointed at its current IP on every boot, so
# https://tally.example.com:8443 works forever — no more changing IPs.
# Your website/email on the domain are unaffected (only this one record is
# touched). See ADR-0018.
# dns_hostname            = "tally.example.com"
# dns_zone                = "example.com"
#
# name                    = "tally-workstation"
# region                  = "ap-south-1"
# instance_type           = "t3.large"
# volume_size_gb          = 100
# snapshot_retention_days = 14
# enable_idle_autostop    = true
